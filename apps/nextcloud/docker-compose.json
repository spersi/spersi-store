 {
         "schemaVersion": 2,
         "services":[
                 {
                 "name": "nextcloud",
                 "environment": [
                        {
                         "key": "NEXTCLOUD_TRUSTED_DOMAINS",
                         "value": "${APP_DOMAIN}"
                        },
                        {
                         "key": "TRUSTED_PROXIES",
                         "value": "172.16.0.0/12"
                        },
                        {
                         "key": "OVERWRITEPROTOCOL",
                         "value": "${APP_PROTOCOL:-http}"
                         }
                                    ],
                 "isMain": true,
                 "internalPort": 80,
                 "volumes": [
                         {
                         "hostPath": "${APP_DATA_DIR}/data/nextcloud",
                         "containerPath": "/var/www/html",
                         "readOnly": false
                         }
                            ]
                 }
                    ]
 }
